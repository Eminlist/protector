rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && 'email' in request.auth.token
        && request.auth.token.email.lower() == 'o553115544@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isEditor() {
      return request.auth != null
        && 'email' in request.auth.token
        && request.auth.token.email.lower() in ['redaktor@gmail.com']
        && request.auth.token.email_verified == true;
    }

    function isRegistered() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function avatarOk() {
      return !('avatar' in request.resource.data)
        || (request.resource.data.avatar is string
            && request.resource.data.avatar.size() < 60000);
    }

    function deviceOk() {
      return !('lastDevice' in request.resource.data)
        || (request.resource.data.lastDevice is string
            && request.resource.data.lastDevice.size() <= 80);
    }

    function usageOk() {
      let d = request.resource.data;
      let o = resource.data;
      let ym = request.time.year() * 100 + request.time.month();
      return (d.get('useM', 0) == o.get('useM', 0) && d.get('useC', 0) == o.get('useC', 0))
        || (d.get('useM', 0) == ym
            && d.get('useC', -1) is int
            && (o.get('useM', 0) != ym || d.get('useC', 0) >= o.get('useC', 0)));
    }

    function ymdNow() {
      return request.time.year() * 10000 + request.time.month() * 100 + request.time.day();
    }

    function queryOk() {
      let d = request.resource.data;
      let o = resource.data;
      return !d.diff(o).affectedKeys().hasAny(['q', 'qAt', 'dK', 'dC'])
        || (d.q is string
            && d.q.size() > 0
            && d.q.size() <= 120
            && d.q != o.get('q', '')
            && d.qAt == request.time
            && (!('qAt' in o) || request.time > o.qAt + duration.value(1, 's'))
            && d.dK == ymdNow()
            && d.dC == (o.get('dK', 0) == ymdNow() ? o.get('dC', 0) : 0) + 1
            && d.dC <= 150);
    }

    function canReadDb() {
      return isRegistered();
    }

    function notBlocked(d) {
      return d.get('deleted', false) != true
        && !(d.get('blocked', false) == true
             && (d.get('blockUntil', 0) == 0 || d.get('blockUntil', 0) > request.time.toMillis()));
    }

    function canOpenModel(id) {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return canReadDb()
        && u.get('q', '') == id
        && notBlocked(u);
    }

    function canReport() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return isRegistered()
        && exists(path)
        && notBlocked(get(path).data);
    }

    // ===== Bayram hədiyyəsi (Bakı vaxtı UTC+4, bayram günü + 2 gün) =====
    function mdOf(t) { return t.month() * 100 + t.day(); }
    function ymdOf(t) { return t.year() * 10000 + t.month() * 100 + t.day(); }

    function holHit(h, id) {
      let v = h.get('dates', {}).get(id, 0);
      let t0 = request.time + duration.value(4, 'h');
      let t1 = t0 - duration.value(1, 'd');
      let t2 = t0 - duration.value(2, 'd');
      return v != 0
        && (v == mdOf(t0) || v == ymdOf(t0)
            || v == mdOf(t1) || v == ymdOf(t1)
            || v == mdOf(t2) || v == ymdOf(t2));
    }

    function holGiftOk() {
      let d = request.resource.data;
      let o = resource.data;
      let h = get(/databases/$(database)/documents/app_data/holidays).data;
      let id = d.get('holGift', '');
      let days = h.get('gifts', {}).get(id, 0);
      let nowMs = request.time.toMillis();
      let base = o.get('premiumUntil', 0) > nowMs ? o.get('premiumUntil', 0) : nowMs;
      let want = base + days * 86400000;
      return id is string && id != ''
        && days > 0
        && holHit(h, id)
        && d.get('holGiftY', 0) == (request.time + duration.value(4, 'h')).year()
        && !(o.get('holGift', '') == id && o.get('holGiftY', 0) == d.get('holGiftY', 0))
        && d.get('premiumUntil', 0) is int
        && d.premiumUntil >= want - 900000
        && d.premiumUntil <= want + 900000
        && notBlocked(o)
        && d.diff(o).affectedKeys().hasOnly(['premiumUntil', 'holGift', 'holGiftY']);
    }

    match /admin/{doc} {
      allow read, write: if isAdmin();
    }

    match /deleted_users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /models/{id} {
      allow get: if isAdmin() || isEditor() || canOpenModel(id);
      allow list: if isAdmin() || isEditor();
      allow write: if isAdmin() || isEditor();
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && !exists(/databases/$(database)/documents/deleted_users/$(userId))
        && request.resource.data.get('blocked', false) == false
        && request.resource.data.get('deleted', false) == false
        && !('premiumUntil' in request.resource.data)
        && !('premiumSince' in request.resource.data)
        && !('blockUntil' in request.resource.data)
        && !('emailVerifiedByAdmin' in request.resource.data)
        && (!request.resource.data.keys().hasAny(['q', 'qAt', 'dK', 'dC'])
            || (request.resource.data.q is string
                && request.resource.data.q.size() > 0
                && request.resource.data.q.size() <= 120
                && request.resource.data.qAt == request.time
                && request.resource.data.dK == ymdNow()
                && request.resource.data.dC == 1))
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time)
        && avatarOk()
        && deviceOk();
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['blocked', 'blockReason', 'blockUntil', 'deleted', 'premiumUntil', 'premiumSince', 'createdAt', 'emailVerifiedByAdmin', 'emailVerifiedAt'])
        && avatarOk()
        && deviceOk()
        && usageOk()
        && queryOk();
      // Bayram hədiyyəsi (yalnız admin aktiv etdiyi bayramda)
      allow update: if isOwner(userId) && holGiftOk();
      allow read, update, delete: if isAdmin();

      match /notifications/{nid} {
        allow read: if isOwner(userId) || isAdmin();
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'thanked']);
        allow delete: if isOwner(userId);
        allow create, update, delete: if isAdmin();
      }

      match /sessions/{sid} {
        allow read, create, update, delete: if isOwner(userId);
        allow read, delete: if isAdmin();
      }
    }

    // Hədiyyə təşəkkürləri: istifadəçi yazır, yalnız admin oxuyur
    match /gift_thanks/{id} {
      allow create: if isRegistered()
        && request.resource.data.keys().hasOnly(['uid', 'nid', 'name', 'email', 'days', 'reason', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nid is string
        && request.resource.data.nid.size() <= 80
        && id == request.auth.uid + '_' + request.resource.data.nid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 100
        && request.resource.data.days is int
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 30
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
    }

    match /payments/{pid} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /block_log/{id} {
      allow read, write: if isAdmin();
    }

    match /app_data/{doc} {
      allow read: if (doc in ['database', 'sizes', 'pubindex'] && (isAdmin() || isEditor()))
        || (doc == 'catalog' && canReadDb())
        || !(doc in ['database', 'sizes', 'pubindex', 'catalog']);
      allow write: if isAdmin() || isEditor();
    }

    match /model_requests/{id} {
      allow create: if canReport()
        && request.resource.data.keys().hasOnly(['text', 'date', 'resolved', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 100
        && request.resource.data.resolved == false;
      allow read, update, delete: if isAdmin();
    }

    match /misfit_reports/{id} {
      allow create: if canReport()
        && request.resource.data.keys().hasOnly(['uid', 'model', 'group', 'comment', 'date', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.model is string
        && request.resource.data.model.size() <= 100
        && request.resource.data.group.size() <= 500
        && request.resource.data.comment.size() <= 300;
      allow read, update, delete: if isAdmin();
    }
  }
}